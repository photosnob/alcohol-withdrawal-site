{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alcohol-withdrawal-site",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    // WordPress URLs end in a slash: /about-us/ serves about-us/index.html, /about-us redirects to /about-us/
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
